	year = {2026},
	journal = {Renewable and Sustainable Energy Reviews},
	volume = {226},
	pages = {},
	doi = {10.1016/j.rser.2025.116420},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105021302164&doi=10.1016%2Fj.rser.2025.116420&partnerID=40&md5=5a21cafdfb936a607cf8835c3fbeb60d},
	abstract = {Supply Chain 5.0 (SC5.0) represents a new paradigm that integrates the principles of Industry 5.0 (I5.0) into Supply Chain Management (SCM), with a strong emphasis on sustainability, resilience, human-centricity, and digital transformation. This work incorporates Circular Economy (CE) practices into the SC5.0 framework and introduces a novel multi-stage decision-making model for designing Circular Supply Chains (CSCs). In the first stage, the study identifies the key indicators associated with both the CE and I5.0, and evaluates their relative importance using the Stochastic Fuzzy Best-Worst Method (SFBWM). In the next stage, the performance of potential Raw Material Providers (RMPs) is assessed through a newly developed approach, the Stochastic Fuzzy Vise Kriterijumska Optimizacija I Kompromisno Resenje (SFVIKOR) method. Following these evaluations, a Robust Stochastic–Possibilistic (RSP) optimization model is formulated with the objective of minimizing costs, Greenhouse Gas (GhG) emissions, and energy consumption, while simultaneously maximizing job creation and Supply Chain (SC) visibility. The proposed framework is validated through a real-world case study in the home appliances sector. To generate optimal solutions, the Chebyshev Multi-Choice Goal Programming with Utility Function (CMCGP-UF) method is applied. The results highlight that robustness, cost efficiency, product quality, waste management, GhG emissions, information system adoption, and workplace safety are the most critical criteria influencing Supply Chain Network Design (SCND). Moreover, the findings indicate that the integration of blockchain-based Information-Sharing Systems (ISSs) and the Internet of Things (IoT) can significantly enhance transparency, adaptability, and overall SC performance. © 2025 Elsevier Ltd},
	author_keywords = {Circular economy; Energy consumption; Industry 5.0; Multi-criteria decision-making; Supply chain management},
