@ARTICLE{Salam2026,
	author = {Salam, Rudi and Raharjo, Kusdi and Arifin, Zainul and Iqbal, Mohammad},
	title = {The role of digital transformation in building business resilience: A comprehensive bibliometric review using biblioshiny},
	year = {2026},
