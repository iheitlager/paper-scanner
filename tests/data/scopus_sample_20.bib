@ARTICLE{Torres202649,
	author = {Torres, Nuno and Chaves, Ana Carolina and Costa, Tiago and Alves, Marcelo Pitanga and Mota, Bruno and Sousa, Cristóvão Dinis and Malta, Silvestre and Pinto, Pedro},
