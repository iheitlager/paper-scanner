@INPROCEEDINGS{10820405,
  author={Akhmadi, Saltanat and Tsakalerou, Mariza},
  booktitle={2024 IEEE 6th International Symposium on Logistics and Industrial Informatics (LINDI)}, 
  title={From Singapore to Kazakhstan: Regionalization Strategies and Metrics for Navigating Digital Transformation}, 
  year={2024},
  volume={},
  number={},
  pages={239-244},
  abstract={This paper explores the regionalization strategy in Singapore to navigate digital transformation disruptions, specifically in the context of supply chain management, and examines the feasibility of implementing a similar strategy in Kazakhstan. It studies the concepts of digital transformation and regionalization strategy and develops an assessment framework to analyze Kazakhstan's potential as a regional hub. The study aims to provide a comprehensive understanding of how regionalization can enhance resilience and efficiency in the face of digital disruptions. The results of the study include four strategies to effectively accelerate digital transformation in Kazakhstan, as well as the policy recommendations on becoming a leading digital economy in Central Asia.},
  keywords={Measurement;Technological innovation;Supply chain management;Navigation;Digital transformation;Government;Information age;Informatics;Logistics;Resilience;digital transformation;regionalization;assessment framework;Singapore;Kazakhstan},
  doi={10.1109/LINDI63813.2024.10820405},
  ISSN={2156-8804},
  month={Oct},}

@INPROCEEDINGS{11256181,
  author={Idoko, Linus and Okojie, Daniel and Eneje, Samiel},
  booktitle={2025 World Engineering Education Forum - Global Engineering Deans Council (WEEF-GEDC)}, 
  title={Driving Digital Innovation: How Industry Partners are Reshaping Engineering Education}, 
  year={2025},
  volume={},
  number={},
  pages={1-9},
  abstract={Engineering education is rapidly evolving due to technological advancements and the demand for industry-ready professionals. While academia has long emphasized theory, digital technologies highlight the need for stronger collaboration with industry to bridge the skills gap and drive innovation. This paper explores how such partnerships transform engineering education by enhancing curricula, boosting employability, and fostering entrepreneurship. Using case studies from Stanford University with Google, the University of Sheffield with RollsRoyce, and the Indian Institute of Technology with Tata Consultancy Services, the study analyses partnership models and institutional records to assess their impact on innovation, engagement, and learning outcomes. Findings show that industry-academic collaborations enrich curricula and research, improve graduate readiness, strengthen faculty development, and expand entrepreneurial opportunities. By aligning education with industry needs, these partnerships create responsive, innovative learning environments that equip students for the digital era. Expanding such collaborations is vital to sustaining a skilled, adaptable workforce and advancing the modernization of engineering education.},
  keywords={Industries;Technological innovation;Analytical models;Adaptation models;Collaboration;Entrepreneurship;Transforms;Internet;Problem-solving;Engineering education;Digital innovation;engineering education;industryacademic partnerships},
  doi={10.1109/WEEF-GEDC66748.2025.11256181},
  ISSN={2837-5025},
  month={Sep.},}

@INPROCEEDINGS{7427775,
  author={Ghezzi, Antonio and Balocco, Raffaello},
  booktitle={2016 49th Hawaii International Conference on System Sciences (HICSS)}, 
  title={Disclosing the Role of IT Suppliers as Digital Innovation Enablers for SMEs: A Strategy Analysis of the European IT Sales Channel}, 
  year={2016},
  volume={},
  number={},
  pages={4740-4749},
  abstract={As Information Technologies (IT) play a growingly strategic role in several industries, Small and Medium Enterprises (SMEs) adopt IT solutions to trigger Digital Innovation supporting their processes and improving their products and services. SMEs' scarce resources and inadequate IT competencies forces them to demand support from IT suppliers in the IT adoption and Digital Innovation journey, however, little attention was paid to the business models and strategies of IT suppliers in the academic and professional literature, and SMEs find it difficult to assess and select IT suppliers that best responds to their needs and aims. This study's goal is to provide a detailed picture of the IT Sales Channel and its players in the European market. A classification framework is proposed and eleven different business models are identified. The study leverages multiple case studies relying on semi-standardized interviews with Chief Executive Officers and Marketing Managers of leading European IT suppliers.},
  keywords={Companies;Technological innovation;Europe;Interviews;Software;Market research;IT channel;SME;Digital Innovation enabler;Business Model},
  doi={10.1109/HICSS.2016.588},
  ISSN={1530-1605},
  month={Jan},}

@INPROCEEDINGS{11115666,
  author={K., Ranjini V. and L., Gururaja B. and Rajeswari, P. S.},
  booktitle={2025 12th International Conference on Computing for Sustainable Global Development (INDIACom)}, 
  title={Role of Digital Transformation on Green Innovation and Sustainability in Food Processing MSMEs: A Review}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Digital transformation has become a potent facilitator that promotes green innovation, enhances operational efficiency, and contributes to sustainability goals. There is a growing global emphasis on green practices adoption across manufacturing industries as a matter of sustainability and environmental protection. Literature reviews in this domain majorly speaks on the benefits in general to overall manufacturing and service sector, but limits industry focused. Hence, this review aims to close this gap by investigating how different digital technologies like IoT, E-commerce platforms, AI, Blockchain propel sustainability and green innovation in food processing sector by reviewing 31 Scopus based literature reviews between 2020 to 2024. The findings underscore the substantial potential of digital transformation to catalyst green innovation. However, to fully harness these benefits, targeted support through financial investments, policy initiatives, and skill development is essential.},
  keywords={Technological innovation;Digital transformation;Green products;Food processing;Blockchains;Electronic commerce;Sustainable development;Artificial intelligence;Protection;Systematic literature review;Digital Transformation;Green Innovation;AI;IoT;Blockchain;E-commerce;Food Processing Sector;Sustainability;Technological Adoption;MSMEs},
  doi={10.23919/INDIACom66777.2025.11115666},
  ISSN={},
  month={April},}

@INPROCEEDINGS{10744180,
  author={Liu, Yanmei and Ma, Pengwei and Pang, Weiwei and Tian, Jiafeng and Wang, Zhuo and Liu, Yuan},
  booktitle={2024 Sixth International Conference on Next Generation Data-driven Networks (NGDN)}, 
  title={Research on Service Capability of Data Platform Suppliers}, 
  year={2024},
  volume={},
  number={},
  pages={200-204},
  abstract={As a crucial factor of production, data plays an important role in the process of digital transformation for enterprises. Data platform is the underlying infrastructure that can provide enterprises with data analysis capabilities, support upper-level data applications, and aid in their digital transformation. Data platform is constructed using blockchain, big data and other technologies. Data platform construction is characterized by its large scale, numerous processes, extended timeframes, and significant costs. The effectiveness of data platform construction depends on product capability and suppliers’ service. Product capability can be guaranteed by testing, while suppliers’ service needs to be assessed. This paper focuses on the construction and implementation of data platform service process, and provides a detailed overview of the industry background, core content, and implementation points of data platform construction services. It also studies and analyzes suppliers’ service capability status. This paper can be used to assess data platform based on blockchain, big data and other technologies.},
  keywords={Industries;Data analysis;Costs;Digital transformation;Standardization;Production;Blockchains;Data mining;Next generation networking;Testing;data platform;service capability;service process},
  doi={10.1109/NGDN61651.2024.10744180},
  ISSN={},
  month={April},}

