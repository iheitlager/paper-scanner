  abstract={Based on the analysis of digital transformation models, and assessment of digital maturity the model and mechanism management digital transformation enterprises. The model of digital transformation of the enterprise defines the participants of the strategic partnership in three institutional spaces. The mechanism of digital transformation of the enterprise is a form of organizational and economic interaction of these participants, who use the methods and tools that ensure these interactions. The proposed model and mechanism for managing the digital transformation of the enterprise is aimed at creating new forms of cooperation in three institutional spaces using short-term flexible cycles of software development, the formation of innovative digital services and its implementation through digital transformation.},
  keywords={Economics;Technological innovation;Analytical models;Digital transformation;Biological system modeling;Conferences;Government;digital transformation;model;mechanism;digital innovations},
  doi={10.1109/ICE/ITMC52061.2021.9570121},
  ISSN={2693-8855},
