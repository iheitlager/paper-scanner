@INPROCEEDINGS{10751076,
  author={Legowo, Nilo and Kristanda, Hengki and Deta, Bernadette},
  booktitle={2024 International Conference on ICT for Smart Society (ICISS)}, 
  title={Smart Insurance Enterprise in Digital Transformation Wave}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={The rapid growth in the number of marketers has contributed greatly to the increase in company revenue. The marketing channel for insurance products through agencies has consistently reached 92% of Company case total annual revenue. The company's growth was also accompanied by an increase in the number of complaints and a decrease in company efficiency. Changes in regulations that often occur also cause an increase in company operating costs which reduce the company's net profits. The purpose of this study is to design a smart enterprise structural design, specifically for the insurance company, based on the conception of TOGAF. The research stages follow the Togaf framework stages starting from preliminary to Architecture Change Management. It is necessary to design an architecture according to management needs to face the digital transformation wave. The result shows the new smart insurance enterprise architecture which is ready to compete.},
  keywords={Costs;Digital transformation;Insurance;Companies;Regulation;Information and communication technology;Faces;Business;Information systems;Enterprise Architecture;Smart enterprise;digital transformation;insurance company;TOGAF -},
  doi={10.1109/ICISS62896.2024.10751076},
  ISSN={},
  month={Sep.},}

@INPROCEEDINGS{11220588,
  author={Sharavova, Olga I. and Sharavova, Maria M. and Kuzovkova, Tatyana A. and Zholtikova, Polina A.},
  booktitle={2025 International Conference on Engineering Management of Communication and Technology (EMCTECH)}, 
  title={Digital Transformation and the Evolution of its Socio-Economic Consequences}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The article is devoted to the study of the evolution of the characteristics of the digital economy and society, highlights the key aspects of assessing the processes of digitalization — the development of information and communication infrastructure, the active introduction of digital technologies and platforms, the strengthening of the role of knowledge as an important element of production, increased attention to information security and adaptation of social institutions. The features of digital development and the consequences of the introduction of new technologies are considered, and the importance of deep transformations in measurement methodology is emphasized, which are necessary to adequately reflect the changes taking place. The systematization of international composite indices of global development, national characteristics of digital development, including changes in the statistical model of digital transformation characteristics, has been carried out. The interrelated system of sources and results of digital transformation is substantiated.},
  keywords={Digital transformation;Digital economy;Ecosystems;Information security;Production;Big Data;Mobile communication;Socioeconomics;Periodic structures;Business;digital transformation;industrial revolutions;statistical indicators of digital development;interrelation of sources and results of digital transformation;technological structure},
